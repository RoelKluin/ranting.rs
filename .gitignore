target/
ranting_derive/target/
ranting_derive/tags
tags
.aider*
.worktrees/
# .claude/ holds local session state (worktrees/, settings.local.json,
# scheduled_tasks.lock) that must stay untracked, but .claude/rules/ is
# checked-in project documentation (see CLAUDE.md's "Task-specific rules"
# table) — it was accidentally caught by the blanket ignore below and had
# never actually been in git history until this fix.
.claude/*
!.claude/rules/
.repo-map/
tasks_done.txt
.cargo-home/

# Scratch, log and scraped-source files — never publish (ROADMAP Phase 4, item 8)
/ranting.log
/ranting_derive/ranting_derive.log
/src.txt
/ranting_derive/src.txt
/git_diff.txt
/git_status.txt
/code_analysis.txt
/review.jsonl
/dodev
/ideas

# Persistent scratch test file for verifying doc examples against real say!()
# output before publishing them — content is overwritten in place, never committed.
/tests/ranting/zz_scratch*.rs

# Scratch harness for testing scripts/overnight_loop.sh; contains a nested git
# repo, so it was committed as a stray gitlink until it was ignored here.
.overnight_test_harness/

# Stray local files unrelated to this crate's purpose (a design asset export
# and an unrelated Inform 7 extensions library) — not part of the project.
/docs/Ranting Cheatsheet Design.zip
/examples/

# Session handoff scratch notes (babysitting/overnight-loop state) — not repo
# documentation; would otherwise get auto-staged by overnight_loop.sh's
# STAGE_EXTENSIONS since it matches *.md.
/mem.md
dupes.txt
*/dupes.txt
