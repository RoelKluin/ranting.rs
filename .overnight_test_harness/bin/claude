#!/usr/bin/env bash
# Stub claude -p: inspects the task text (argv[2], since argv[1] is "-p") and
# does exactly what the real task would do, without calling out anywhere.
task="$2"
case "$task" in
  *"mid-run rewrite"*)
    # Simulates item 13: a task editing the running loop script on disk,
    # leaving an untracked scratch file, and making one genuine source edit.
    cat >>scripts/overnight_loop.sh <<'INNER'

echo "REEXEC_MARKER: injected code ran" >> "$LOG_FILE"
INNER
    echo "scratch content, should never be committed" >tmp_failed_lib.rs
    echo "// touched by task1" >>src/lib.rs
    ;;
  *"normal task"*)
    echo "// touched by task2" >>src/lib.rs
    ;;
esac
exit 0
