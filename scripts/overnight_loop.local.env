# Pins this repo's log/lock paths so overnight_loop.sh doesn't collide with
# another repo also bind-mounted at /work in a different claude-box container
# sharing the claude-home volume (LOG_DIR/LOCK_DIR default to a basename of
# the repo path, "work", not the repo's identity). See mem.md's "operational
# traps" note.
LOG_DIR=/home/coder/logs/ranting
LOCK_DIR=/home/coder/logs/.overnight_loop_locks_ranting
